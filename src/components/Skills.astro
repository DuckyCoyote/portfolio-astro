---
/*
 * Skills — four category cards in a row, plus a stats row at the bottom.
 *
 * Each category card has:
 *   • a colored header with the section title and icon
 *   • a cream body listing the technologies, each prefixed by a small
 *     black square "bullet"
 *
 * The stats row uses inverted colors (black background, green numbers)
 * to look like a worn arcade high-score panel.
 */

import { skillCategories, skillStats } from '../data/portfolio';
import Icon from './Icon.astro';
import type { SkillCategory } from '../data/portfolio';

const categories: SkillCategory[] = skillCategories;
---

<section id="skills" class="section skills">
  <div class="container">

    <header class="section-header">
      <span class="section-header__icon section-header__icon--cream">
        <Icon name="code-2" size={16} />
      </span>
      <h2 class="section-title">Skills &amp; Tecnologías</h2>
    </header>

    <div class="grid skills__grid">
      {categories.map((category) => (
        <article class="card-flat skills__card hover-slide-up">
          <header class={`skills__header ${category.colorClass}`}>
            <Icon
              name={
                category.icon === 'layout'   ? 'layout'    :
                category.icon === 'server'   ? 'server'    :
                category.icon === 'mobile'   ? 'smartphone':
                'zap'
              }
              size={28}
            />
            <h3 class="skills__title">{category.title}</h3>
          </header>
          <ul class="skills__list">
            {category.skills.map((skill) => (
              <li class="skills__item">
                <span class="skills__bullet" aria-hidden="true"></span>
                <span class="skills__name">{skill}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    {/* Stats row */}
    <div class="grid grid--4 skills__stats">
      {skillStats.map((stat) => (
        <div class="skills__stat">
          <div class="skills__stat-value text-green">{stat.value}</div>
          <div class="skills__stat-label text-white">{stat.label}</div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* The Skills section has a white background to break up the page —
     sandwiched between the cream About and Experience sections. */
  .skills {
    background-color: var(--color-white);
    border-top: var(--border-bottom-thick);
    border-bottom: var(--border-bottom-thick);
  }

  /* ---------- Category card ---------- */

  /* 1 → 2 → 4 columns (the stats row below uses the 2 → 4 .grid--4). */
  .skills__grid { grid-template-columns: 1fr; }

  @media (min-width: 48rem) {
    .skills__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .skills__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .skills__header {
    border-bottom: var(--border-bottom-thick);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .skills__title {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .skills__list {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .skills__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .skills__bullet {
    width: 0.75rem;
    height: 0.75rem;
    background-color: var(--color-black);
    border: 2px solid var(--color-black);
  }

  .skills__name {
    font-weight: 700;
  }

  /* ---------- Stats row ---------- */

  .skills__stats {
    margin-top: var(--space-12);
    gap: var(--space-4);
  }

  .skills__stat {
    border: var(--border-medium);
    background-color: var(--color-black);
    text-align: center;
    padding: var(--space-6);
  }

  .skills__stat-value {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  @media (min-width: 48rem) {
    .skills__stat-value { font-size: var(--text-4xl); }
  }

  .skills__stat-label {
    font-weight: 700;
  }
</style>
