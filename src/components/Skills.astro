---
/*
 * Skills — a terminal session.
 *
 *   $ neofetch          → ASCII duck + the headline stats as key/value rows
 *   $ ls stack/         → one double-line TUI pane per skill category
 *
 * The neofetch colour blocks are the one place the old neon palette lives.
 */

import { skillCategories, skillStats, heroContent } from '../data/portfolio';
import { getI18n } from '../i18n';
import Window from './Window.astro';

const { t, l } = getI18n(Astro);

const PROMPT = 'alejo@portfolio:~/skills$';

const DUCK = String.raw`
    __
___( o)>
\ <_. )
 '---'`.slice(1);

const fetchRows = [
  { key: t.skills.role, value: heroContent.role },
  ...skillStats.map((stat) => ({ key: l(stat.label), value: stat.value })),
];
---

<section id="skills" class="section skills">
  <div class="container">
    <Window title={t.skills.window} variant="terminal">

      <div class="skills__session" data-typewriter>
      <p class="term-line" data-kind="cmd"><span class="term-prompt">{PROMPT} </span><span data-text>neofetch</span></p>

      <div class="skills__fetch">
        <pre class="skills__duck" aria-hidden="true">{DUCK}</pre>
        <div>
          <p class="term-line skills__host">alejo<span class="term-dim">@</span>portfolio</p>
          <p class="term-line term-dim" aria-hidden="true">─────────────────</p>
          <dl class="skills__stats">
            {fetchRows.map((row) => (
              <div class="skills__stat">
                <dt>{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
          <div class="skills__palette" aria-hidden="true">
            <span style="background: var(--term-bg); outline: 1px solid var(--term-dim);"></span>
            <span style="background: var(--term-fg);"></span>
            <span style="background: var(--neon-yellow);"></span>
            <span style="background: var(--neon-magenta);"></span>
            <span style="background: var(--neon-cyan);"></span>
            <span style="background: var(--neon-coral);"></span>
            <span style="background: var(--term-bright);"></span>
          </div>
        </div>
      </div>

      <p class="term-line" data-kind="cmd"><span class="term-prompt">{PROMPT} </span><span data-text>ls stack/</span></p>

      <div class="skills__grid" data-stagger>
        {skillCategories.map((category) => (
          <div class="tui-box">
            <h3 class="tui-box__title">{l(category.title)}</h3>
            <ul class="skills__list">
              {category.skills.map((skill) => (
                <li><span class="term-dim" aria-hidden="true">›</span> {skill}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="term-line"><span class="term-prompt">{PROMPT}</span> <span class="term-cursor" aria-hidden="true"></span></p>
      </div>

    </Window>
  </div>
</section>

<style>
  .skills__session {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .skills :global(.window__body) { padding: var(--space-8); }
  }

  /* ---------- neofetch ---------- */

  .skills__fetch {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4) var(--space-10);
    margin-bottom: var(--space-4);
  }

  .skills__duck {
    margin: 0;
    font: inherit;
    font-size: 1.3em;
    line-height: 1.05;
    color: var(--term-fg);
  }

  .skills__host {
    color: var(--term-bright);
  }

  .skills__stats {
    display: grid;
    gap: 0;
  }

  .skills__stat {
    display: grid;
    grid-template-columns: 10ch 1fr;
  }

  .skills__stat dt {
    color: var(--term-bright);
  }

  .skills__palette {
    display: flex;
    gap: 0;
    margin-top: var(--space-3);
  }

  .skills__palette span {
    width: 2rem;
    height: 1.1rem;
  }

  /* ---------- Category panes ---------- */

  .skills__grid {
    display: grid;
    gap: var(--space-6) var(--space-4);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 40rem) {
    .skills__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .skills__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .skills__list {
    display: grid;
    gap: var(--space-1);
  }
</style>
