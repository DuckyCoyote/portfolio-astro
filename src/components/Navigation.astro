---
/*
 * Menu bar — the System 1 strip across the top of the screen.
 *
 * The pixel duck plays the role of the Apple menu: it opens a pull-down
 * with every section plus external links. On desktop the sections are
 * also listed inline as menu titles; on mobile the duck menu is the whole
 * navigation. On the right: the language switcher (like System 7's script
 * menu), a sun/moon theme toggle and a clock.
 *
 * Open/close and the clock are handled by the script in BaseLayout.astro;
 * the theme toggle, language switch and Control Panel entry by
 * src/scripts/preferences.ts.
 */

import { navItems, socialLinks } from '../data/portfolio';
import { getI18n, localePath } from '../i18n';
import PixelIcon from './PixelIcon.astro';

const { locale, t, l } = getI18n(Astro);
const otherLocale = locale === 'es' ? 'en' : 'es';
const externalLinks = socialLinks.filter((link) => link.url.startsWith('http'));
---

<nav class="menubar" aria-label={t.nav.label}>
  <div class="menubar__inner">
    <div class="menubar__apple">
      <button
        type="button"
        class="menubar__item menubar__duck"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="duck-menu"
        data-menu-button
      >
        <PixelIcon name="duck" scale={2} />
        <span class="menubar__app">Alejo</span>
      </button>

      <div class="menubar__dropdown" id="duck-menu" data-menu hidden>
        <a class="menubar__entry" href="#about">{t.nav.about}</a>
        <button type="button" class="menubar__entry" data-open-preferences>{t.nav.controlPanel}</button>
        <hr class="menubar__sep" />
        {navItems.map((item) => (
          <a class="menubar__entry" href={item.href}>{l(item.label)}</a>
        ))}
        <hr class="menubar__sep" />
        {externalLinks.map((link) => (
          <a class="menubar__entry" href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label === 'github' ? 'GitHub' : 'LinkedIn'}
          </a>
        ))}
      </div>
    </div>

    <ul class="menubar__titles md-only">
      {navItems.filter((item) => item.href !== '#hero').map((item) => (
        <li><a class="menubar__item" href={item.href}>{l(item.label)}</a></li>
      ))}
    </ul>

    <a
      class="menubar__item menubar__lang"
      href={localePath(otherLocale)}
      hreflang={otherLocale}
      lang={otherLocale}
      title={t.nav.switchLanguage}
      aria-label={t.nav.switchLanguage}
      data-lang-switch={otherLocale}
    >
      {otherLocale.toUpperCase()}
    </a>

    <button type="button" class="menubar__item menubar__theme" data-theme-toggle aria-label={t.theme.switchTo('dark')}>
      <PixelIcon name="moon" scale={2} class="menubar__moon" />
      <PixelIcon name="sun" scale={2} class="menubar__sun" />
    </button>

    <time class="menubar__clock" data-clock aria-label={t.nav.clock}></time>
  </div>
</nav>

<style>
  .menubar {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--paper);
    border-bottom: var(--line);
    font-family: var(--font-system);
    font-size: var(--text-base);
  }

  .menubar__inner {
    display: flex;
    align-items: stretch;
    height: var(--menubar-height);
    padding-inline: var(--space-2);
  }

  .menubar__apple {
    position: relative;
    display: flex;
  }

  .menubar__titles {
    display: flex;
  }

  /* Each menu title inverts when hovered or open — exactly like the Finder. */
  .menubar__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
    padding-inline: var(--space-3);
    text-decoration: none;
  }

  .menubar__item:hover,
  .menubar__duck[aria-expanded="true"] {
    background-color: var(--ink);
    color: var(--paper);
  }

  .menubar__item:hover :global(svg),
  .menubar__duck[aria-expanded="true"] :global(svg) {
    filter: invert(1);
  }

  .menubar__item:focus-visible {
    outline-offset: -4px;
  }

  .menubar__app {
    font-weight: 700;
  }

  /* Language switcher: shows the language you'd switch to. */
  .menubar__lang {
    margin-left: auto;
    font-weight: 700;
  }

  /* Shows the theme you'd switch to: a moon in light mode, a sun in dark. */

  /* The icons are PixelIcon children, so they're reached via :global. */
  .menubar__theme :global(.menubar__sun) { display: none; }

  :global(:root[data-theme="dark"]) .menubar__theme :global(.menubar__sun) { display: block; }
  :global(:root[data-theme="dark"]) .menubar__theme :global(.menubar__moon) { display: none; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .menubar__theme :global(.menubar__sun) { display: block; }
    :global(:root:not([data-theme="light"])) .menubar__theme :global(.menubar__moon) { display: none; }
  }

  .menubar__clock {
    display: flex;
    align-items: center;
    padding-inline: var(--space-3);
  }

  /* ---------- Pull-down menu ---------- */

  .menubar__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 15rem;
    margin-top: var(--px);
    padding-block: var(--space-1);
    background-color: var(--paper);
    border: var(--line);
    box-shadow: var(--shadow-menu);
  }

  .menubar__dropdown:not([hidden]) {
    display: flex;
    flex-direction: column;
  }

  .menubar__entry {
    padding: var(--space-1) var(--space-6);
    text-align: left;
    text-decoration: none;
  }

  .menubar__entry:hover,
  .menubar__entry:focus-visible {
    background-color: var(--ink);
    color: var(--paper);
    outline: none;
  }

  /* The chosen entry flashes twice before the menu closes. */
  .menubar__entry.is-blinking {
    animation: menu-blink 240ms steps(1, end);
  }

  @keyframes menu-blink {
    0%, 50%  { background-color: var(--ink);   color: var(--paper); }
    25%, 75% { background-color: var(--paper); color: var(--ink); }
  }

  /* The dotted separator lines of a classic Mac menu. */
  .menubar__sep {
    margin: var(--space-1) 0;
    border: 0;
    border-top: var(--px) dotted var(--ink);
  }
</style>
