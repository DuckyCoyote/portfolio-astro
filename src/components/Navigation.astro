---
/*
 * Navigation — sticky top bar with desktop links and a mobile menu.
 *
 * The mobile menu's open/close state is handled by a small inline script
 * in BaseLayout.astro — this component only renders the markup and the
 * data attributes the script reads.
 */

import { navItems } from '../data/portfolio';
---

<nav class="nav">
  <div class="nav__inner container">
    <div class="nav__brand">
      <span class="nav__brand-mark" aria-hidden="true">
        <span class="nav__brand-dot"></span>
      </span>
      <span class="nav__brand-name">DEV.PORTFOLIO</span>
    </div>

    {/* Desktop nav */}
    <ul class="nav__list">
      {navItems.map((item) => (
        <li>
          <a class="btn btn--secondary nav__link" href={item.href}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    {/* Mobile menu button */}
    <button
      type="button"
      class="nav__menu-button btn btn--secondary"
      aria-label="Abrir menú"
      aria-expanded="false"
      data-menu-button
    >
      <span class="nav__menu-button-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="6"  y2="6"  />
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
      </span>
    </button>
  </div>

  {/* Mobile menu — hidden by default, shown via [data-open="true"] */}
  <div class="container nav__mobile" data-mobile-menu data-open="false">
    {navItems.map((item) => (
      <a class="btn btn--secondary nav__link nav__link--mobile" href={item.href}>
        {item.label}
      </a>
    ))}
  </div>
</nav>

<style>
  /* The nav uses its own container width (a bit wider than section padding
     so the brand and the menu have room to breathe). */

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-white);
    border-bottom: var(--border-bottom-thick);
  }

  .nav__inner {
    max-width: var(--container-wide);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* The brand mark is a small black square with a green pixel inside —
     a tiny visual pun on the "pixel art" theme. */
  .nav__brand-mark {
    width: 2.5rem;
    height: 2.5rem;
    border: var(--border-medium);
    background-color: var(--color-black);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav__brand-dot {
    width: 0.75rem;
    height: 0.75rem;
    background-color: var(--color-green);
    display: block;
  }

  .nav__brand-name {
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  /* Desktop links only from md up; the hamburger + drawer cover mobile. */
  .nav__list {
    display: none;
    gap: var(--space-2);
  }

  .nav__link {
    padding-block: var(--space-2);
    padding-inline: var(--space-4);
  }

  .nav__menu-button {
    padding: var(--space-2);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }

  .nav__mobile[data-open="true"] {
    display: flex;
  }

  .nav__link--mobile {
    width: 100%;
    text-align: center;
  }

  @media (min-width: 48rem) {
    .nav__list { display: flex; }
    .nav__menu-button,
    .nav__mobile[data-open="true"] { display: none; }
  }
</style>
