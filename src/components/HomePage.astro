---
/*
 * The home page, shared by every language ("/" and "/en/").
 *
 * The sections are stacked top-to-bottom in the order a visitor should see
 * them. Each component reads the language from Astro.currentLocale, so the
 * pages themselves only pick the route. Everything renders statically at
 * build time — there is no per-request work.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from './Navigation.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Skills from './Skills.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Preferences from './Preferences.astro';
---

<BaseLayout>
  <Navigation />
  <main>
    <Hero />
    <About />
    <Skills />
    <Experience />
    <Projects />
    <Contact />
  </main>
  <Footer />
  <Preferences />
</BaseLayout>
