---
/*
 * Contact — a Mac dialog box for the form, a terminal for the details.
 *
 * The form is a real <form> with accessible labels and native validation.
 * Without JS it falls back to a mailto: POST (opens the visitor's mail app)
 * so the fields never end up in the page URL.
 * Behavior (validation, cooldown, EmailJS delivery) is wired up in
 * /src/scripts/contact-form.ts, which reads the data-* attributes below.
 * The status banner stays hidden until the script shows it.
 */

import { socialLinks, contactPhone, contactIntro, contactEmail } from '../data/portfolio';
import Window from './Window.astro';
import PixelIcon from './PixelIcon.astro';

const MESSAGE_MAX = 1000;
const PROMPT = 'alejo@portfolio:~$';
const KEY_WIDTH = 10;
const pad = (key: string) => key.padEnd(KEY_WIDTH, ' ');
---

<section id="contact" class="section">
  <div class="container contact__grid">

    {/* ============== Dialog: the form ============== */}
    <div class="dialog contact__dialog" data-zoom>
      <header class="contact__head">
        <PixelIcon name="mail" scale={3} />
        <div>
          <h2 class="contact__title">Contacto</h2>
          <p class="contact__lead">Envíame un mensaje y te respondo por email.</p>
        </div>
      </header>

      <form
        class="contact__form"
        method="post"
        action={`mailto:${contactEmail}`}
        enctype="text/plain"
        data-contact-form
      >
        <div class="field">
          <label class="field__label" for="contact-name">Nombre</label>
          <input
            class="field__input"
            type="text"
            id="contact-name"
            name="name"
            required
            minlength="2"
            maxlength="100"
            autocomplete="name"
            placeholder="Tu nombre"
            data-contact-name
          />
        </div>

        <div class="field">
          <label class="field__label" for="contact-email">Email</label>
          <input
            class="field__input"
            type="email"
            id="contact-email"
            name="email"
            required
            autocomplete="email"
            placeholder="tu@email.com"
            data-contact-email
          />
        </div>

        <div class="field">
          <label class="field__label" for="contact-message">
            Mensaje
            <span class="field__hint"><span data-contact-counter>0</span>/{MESSAGE_MAX}</span>
          </label>
          <textarea
            class="field__input"
            id="contact-message"
            name="message"
            required
            minlength="10"
            maxlength={MESSAGE_MAX}
            rows="5"
            placeholder="Cuéntame tu idea (mínimo 10 caracteres)"
            data-contact-message
          ></textarea>
        </div>

        {/* Status banner — kinds: success | error | cooldown | limit */}
        <div
          class="banner"
          role="status"
          aria-live="polite"
          data-contact-banner
          data-kind=""
          hidden
        ></div>

        <div class="contact__actions">
          <button class="btn" type="reset">Borrar</button>
          <button class="btn btn--default" type="submit" data-contact-submit>
            <span data-contact-submit-label>Enviar mensaje</span>
          </button>
        </div>
      </form>
    </div>

    {/* ============== Terminal: details ============== */}
    <Window title="contacto.sh" titleAs="span" variant="terminal" class="contact__terminal">
      <div class="contact__session" data-typewriter>
      <p class="term-line" data-kind="cmd"><span class="term-prompt">{PROMPT} </span><span data-text>cat léeme.txt</span></p>
      <p class="term-line term-dim contact__intro"># {contactIntro}</p>

      <p class="term-line" data-kind="cmd"><span class="term-prompt">{PROMPT} </span><span data-text>contacto --list</span></p>
      <dl class="contact__list" data-stagger>
        {socialLinks.map((link) => (
          <div class="term-line">
            <dt>{pad(link.label)}</dt>
            <dd>
              <a
                href={link.url}
                target={link.url.startsWith('http') ? '_blank' : undefined}
                rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              >{link.handle}</a>
            </dd>
          </div>
        ))}
        <div class="term-line">
          <dt>{pad('teléfono')}</dt>
          <dd>{contactPhone}</dd>
        </div>
      </dl>

      <p class="term-line" data-kind="cmd"><span class="term-prompt">{PROMPT} </span><span data-text>status</span></p>
      <p class="term-line contact__status">
        <span class="contact__led" aria-hidden="true"></span> Disponible
      </p>

      <p class="term-line"><span class="term-prompt">{PROMPT}</span> <span class="term-cursor" aria-hidden="true"></span></p>
      </div>
    </Window>

  </div>
</section>

<script>
  /* Wire up the form. The actual logic lives in src/scripts/contact-form.ts;
     this block is a thin Astro script entry point. */
  import '../scripts/contact-form';
</script>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-10);
    }

    .contact__terminal {
      margin-top: var(--space-10);
    }
  }

  /* ============== Dialog ============== */

  .contact__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .contact__title {
    font-size: var(--text-2xl);
  }

  .contact__lead {
    margin-top: var(--space-1);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  /* ============== Terminal ============== */

  .contact__session {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact__intro {
    max-width: 48ch;
    margin-bottom: var(--space-2);
  }

  .contact__list {
    margin-bottom: var(--space-2);
  }

  .contact__list > div {
    display: flex;
    flex-wrap: wrap;
    white-space: normal;   /* only the padded key keeps its spaces */
  }

  .contact__list dt {
    color: var(--term-bright);
    white-space: pre;
  }

  .contact__status {
    display: flex;
    align-items: center;
    gap: 1ch;
    margin-bottom: var(--space-2);
  }

  .contact__led {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background-color: var(--term-fg);
    box-shadow: 0 0 8px var(--term-fg);
  }
</style>
