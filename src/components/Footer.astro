---
/*
 * Site footer — a single line of copyright text.
 *
 * Kept tiny because everything else lives in its own section above.
 * The cream background of the page seeps through; only the top border and
 * the centered copy live here.
 */
---

<footer class="site-footer">
  <p class="site-footer__text">© 2026 - Made with ❤️ and pixels</p>
</footer>

<style>
  .site-footer {
    border-top: var(--border-bottom-thick);
    background-color: var(--color-white);
    padding-block: var(--space-6);
    text-align: center;
  }

  .site-footer__text {
    font-weight: 700;
  }
</style>
