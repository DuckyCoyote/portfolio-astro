---
/*
 * Projects — a Finder window full of documents.
 *
 * Each project is a framed card: name + status strip, a screenshot, the
 * description, tech tags and two Mac buttons. Screenshots render in
 * greyscale to match the 1-bit desktop and get their colour back on hover
 * (only on devices that can hover, so touch screens always see colour).
 *
 * Projects whose links are still "#" are marked as in progress and their
 * buttons are dimmed like unavailable menu commands.
 */

import { projects, FALLBACK_PROJECT_IMAGE } from '../data/portfolio';
import { getI18n } from '../i18n';
import Window from './Window.astro';

const { t, l } = getI18n(Astro);

const isLive = (url: string) => url !== '#';
const liveCount = projects.filter((project) => isLive(project.link)).length;
---

<section id="projects" class="section">
  <div class="container">
    <Window
      title={t.projects.window}
      info={[
        t.projects.total(projects.length),
        t.projects.live(liveCount),
        t.projects.inProgress(projects.length - liveCount),
      ]}
    >
      <ul class="projects__grid">
        {projects.map((project) => {
          const live = isLive(project.link);
          const hasCode = isLive(project.github);
          return (
            <li class="projects__card">
              <header class="projects__head">
                <h3 class="projects__title">{project.title}</h3>
                <span class="projects__status">{live ? t.projects.statusLive : t.projects.statusInProgress}</span>
              </header>

              <div class="projects__image-wrap">
                <img
                  class="projects__image"
                  src={project.image || FALLBACK_PROJECT_IMAGE}
                  alt={t.projects.screenshot(project.title)}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="projects__body">
                <p class="projects__description">{l(project.description)}</p>

                <ul class="projects__technologies" aria-label={t.experience.technologies}>
                  {project.technologies.map((tech) => <li class="tag">{tech}</li>)}
                </ul>

                <div class="projects__links">
                  <a
                    class="btn btn--default flex-1"
                    href={live ? project.link : undefined}
                    aria-disabled={live ? undefined : 'true'}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t.projects.open}
                  </a>
                  <a
                    class="btn flex-1"
                    href={hasCode ? project.github : undefined}
                    aria-disabled={hasCode ? undefined : 'true'}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t.projects.code}
                  </a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </Window>
  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 40rem) {
    .projects__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .projects__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .projects__card {
    display: flex;
    flex-direction: column;
    border: var(--line);
    box-shadow: var(--shadow-window);
    background-color: var(--paper);
  }

  .projects__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--line);
  }

  .projects__title {
    font-size: var(--text-lg);
  }

  .projects__status {
    flex-shrink: 0;
    font-family: var(--font-system);
    font-size: var(--text-xs);
  }

  .projects__image-wrap {
    aspect-ratio: 16 / 10;
    border-bottom: var(--line);
    overflow: hidden;
    background-color: var(--paper);
  }

  .projects__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: hover) {
    .projects__image {
      filter: grayscale(1) contrast(1.15);
      transition: filter 200ms steps(3);
    }

    .projects__card:hover .projects__image,
    .projects__card:focus-within .projects__image {
      filter: none;
    }
  }

  .projects__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-4);
  }

  .projects__description {
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .projects__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .projects__links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
  }
</style>
