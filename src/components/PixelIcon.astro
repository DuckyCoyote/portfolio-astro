    'XooooooXXXXooX',
    'XooooooooooooX',
    'XXXXXXXXXXXXXX',
    'XooooooooooooX',
    'XXXXXXXXXXXXXX',
  ],
};

const rows = GRIDS[name];
const width = Math.max(...rows.map((r) => r.length));
const height = rows.length;

type Run = { x: number; y: number; w: number; tone: 'px-ink' | 'px-paper' };
const runs: Run[] = [];
rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x];
    if (ch === '.') { x++; continue; }
    let end = x;
    while (end < row.length && row[end] === ch) end++;
    runs.push({ x, y, w: end - x, tone: ch === 'X' ? 'px-ink' : 'px-paper' });
    x = end;
  }
});
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={width * scale}
  height={height * scale}
  viewBox={`0 0 ${width} ${height}`}
  shape-rendering="crispEdges"
  class={className}
  aria-hidden="true"
>
  {runs.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" class={r.tone} />)}
</svg>
