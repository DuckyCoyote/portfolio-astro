---
/*
 * 1-bit pixel icons, drawn from ASCII grids.
 *
 *   X = black pixel   o = white pixel   . = transparent
 *
 * Each row is turned into horizontal runs of <rect>s so the SVG stays tiny
 * and crisp at any integer scale. White pixels matter: they keep icons
 * readable on top of the dithered desktop. Both colours come from the
 * theme tokens (see .px-ink / .px-paper in components.css), so icons
 * invert with the dark theme.
 */

export type PixelIconName =
  'duck' | 'folder' | 'document' | 'mail' | 'disk' | 'trash' | 'trash-full' | 'computer' | 'moon' | 'sun';

interface Props {
  name: PixelIconName;
  /** CSS pixels per icon pixel. */
  scale?: number;
  class?: string;
}

const { name, scale = 2, class: className = '' } = Astro.props;

const GRIDS: Record<PixelIconName, string[]> = {
