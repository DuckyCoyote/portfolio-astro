---
/*
 * Hero — the desktop as it looks right after boot.
 *
 *   ┌ Léeme ───────────────┐          [folder] Proyectos
 *   │ Hola.                 │          [doc]    Experiencia
 *   │ Soy Alejo.            │          [mail]   Contacto
 *   │ tagline  [Ver] [Cont] │          [disk]   GitHub
 *   └──────────┌ Terminal ──────────┐
 *              │ $ whoami            │
 *              └─────────────────────┘          [trash]
 *
 * On load both windows zoom open and the terminal types its lines; on wide
 * screens the windows can be dragged around by their title bars. All of it
 * lives in src/scripts/motion.ts — without JS, or with reduced motion, the
 * desktop renders complete and still.
 */

import { heroContent, siteMeta } from '../data/portfolio';
import Window from './Window.astro';
import PixelIcon from './PixelIcon.astro';
import Trash from './Trash.astro';
import type { PixelIconName } from './PixelIcon.astro';

const deskIcons: { label: string; href: string; icon: PixelIconName; external?: boolean }[] = [
  { label: 'Proyectos',   href: '#projects',   icon: 'folder' },
  { label: 'Experiencia', href: '#experience', icon: 'document' },
  { label: 'Contacto',    href: '#contact',    icon: 'mail' },
  { label: 'GitHub',      href: 'https://github.com/DuckyCoyote', icon: 'disk', external: true },
];

const PROMPT = 'alejo@portfolio:~$';
const terminalLines = [
  { kind: 'cmd', text: 'whoami' },
  { kind: 'out', text: `${siteMeta.author}, ${heroContent.role}` },
  { kind: 'cmd', text: 'cat estado.txt' },
  { kind: 'out', text: heroContent.status },
] as const;
---

<section id="hero" class="hero">
  <div class="container hero__desktop">

    <div class="hero__windows">
      <Window
        title="Léeme"
        titleAs="span"
        info={[heroContent.role, 'Disponible']}
        class="hero__readme"
      >
        <h1 class="hero__heading">
          <span class="hero__line">{heroContent.greeting}</span>
          <span class="hero__line">{heroContent.name}</span>
        </h1>

        <p class="hero__tagline">{heroContent.tagline}</p>

        <div class="hero__actions">
          <a class="btn btn--default" href={heroContent.primaryCta.href}>
            {heroContent.primaryCta.label}
          </a>
          <a class="btn" href={heroContent.secondaryCta.href}>
            {heroContent.secondaryCta.label}
          </a>
        </div>
      </Window>

      <Window title="Terminal" titleAs="span" variant="terminal" class="hero__terminal">
        <div data-typewriter>
          {terminalLines.map((line) => (
            /* One line on purpose: .term-line preserves whitespace. */
            <p class="term-line" data-kind={line.kind}>{line.kind === 'cmd' && <span class="term-prompt">{PROMPT} </span>}<span data-text>{line.text}</span></p>
          ))}
          <p class="term-line"><span class="term-prompt">{PROMPT} </span><span class="term-cursor" aria-hidden="true"></span></p>
        </div>
      </Window>
    </div>

    <nav class="hero__icons" aria-label="Accesos directos">
      {deskIcons.map((item) => (
        <a
          class="desk-icon"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <PixelIcon name={item.icon} scale={3} />
          <span class="desk-icon__label">{item.label}</span>
        </a>
      ))}
      <Trash class="hero__trash" />
    </nav>

  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-10);
  }

  .hero__desktop {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .hero {
      min-height: calc(100vh - var(--menubar-height));
      display: flex;
      align-items: center;
    }

    .hero__desktop {
      grid-template-columns: 1fr auto;
      align-items: stretch;
    }
  }

  /* ---------- Windows ---------- */

  .hero__windows {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__readme {
    position: relative;
    max-width: 44rem;
  }

  /* Title bars are drag handles on wide screens (see motion.ts). */
  @media (min-width: 64rem) and (pointer: fine) {
    .hero__windows :global(.window__titlebar) { cursor: grab; }
    .hero__windows :global(.window__titlebar.is-dragging) { cursor: grabbing; }
  }

  /* On wide screens the terminal overlaps the Read Me window, like two
     windows left open on the desktop. */
  @media (min-width: 64rem) {
    .hero__windows { gap: 0; }

    .hero__terminal {
      position: relative;
      z-index: 1;
      width: min(36rem, 70%);
      margin-left: auto;
      margin-top: calc(-1 * var(--space-12));
    }
  }

  .hero__heading {
    font-size: var(--text-hero);
    line-height: 0.95;
    margin-bottom: var(--space-5);
  }

  .hero__line {
    display: block;
  }

  .hero__tagline {
    font-size: var(--text-lg);
    max-width: 34ch;
    margin-bottom: var(--space-8);
  }

  @media (min-width: 48rem) {
    .hero__tagline { font-size: var(--text-xl); }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__terminal :global(.window__body) {
    min-height: 9.5rem;
  }

  /* ---------- Desktop icons ---------- */

  .hero__icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* The trash (an easter egg, see Trash.astro) only sits on the wide
     desktop. It's a child component, hence :global. */
  .hero__icons :global(.hero__trash) {
    display: none;
  }

  @media (min-width: 64rem) {
    .hero__icons {
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: var(--space-6);
    }

    .hero__icons :global(.hero__trash) {
      display: inline-flex;
      margin-top: auto;
    }
  }
</style>
