---
/*
 * Experience — the Finder's list view.
 *
 *   Puesto                    Empresa          Período
 *   ▾ [doc] Full Stack Dev    Credibusiness    Mayo 2025 – Mayo 2026
 *       description…
 *       [Angular.Js] [Node.js] …
 *
 * Each row is a <details> element, open by default so nothing is hidden
 * from a recruiter skimming the page; the triangle still collapses it.
 */

import { experiences } from '../data/portfolio';
import { getI18n } from '../i18n';
import Window from './Window.astro';
import PixelIcon from './PixelIcon.astro';

const { t, l } = getI18n(Astro);
const years = new Set(experiences.flatMap((job) => l(job.period).match(/\d{4}/g) ?? []));
const firstYear = Math.min(...[...years].map(Number));
---

<section id="experience" class="section experience">
  <div class="container">
    <Window
      title={t.experience.window}
      info={[t.experience.jobs(experiences.length), t.experience.since(firstYear), t.experience.newestFirst]}
    >
      <div class="experience__columns" aria-hidden="true">
        <span>{t.experience.columns.role}</span>
        <span class="md-only">{t.experience.columns.company}</span>
        <span class="md-only">{t.experience.columns.period}</span>
      </div>

      <ul class="experience__list">
        {experiences.map((job) => (
          <li>
            <details class="experience__row" open>
              <summary class="experience__summary">
                <span class="experience__name">
                  <span class="experience__triangle" aria-hidden="true"></span>
                  <PixelIcon name="document" scale={1.5} />
                  <h3 class="experience__title">{job.title}</h3>
                </span>
                <span class="experience__company">{job.company}</span>
                <span class="experience__period">{l(job.period)}</span>
              </summary>

              <div class="experience__detail">
                <p class="experience__description">{l(job.description)}</p>
                <ul class="experience__technologies" aria-label={t.experience.technologies}>
                  {job.technologies.map((tech) => <li class="tag">{tech}</li>)}
                </ul>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </Window>
  </div>
</section>

<style>
  /* Rows run edge to edge, like the Finder's list view. */
  .experience :global(.window__body) {
    padding: 0;
  }

  .experience__columns,
  .experience__summary {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--space-4);
    padding-inline: var(--space-5);
  }

  @media (min-width: 48rem) {
    .experience__columns,
    .experience__summary {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .experience__columns {
    padding-block: var(--space-2);
    border-bottom: var(--line);
    font-family: var(--font-system);
    font-size: var(--text-sm);
  }

  .experience__row {
    border-bottom: var(--px) dotted var(--ink);
  }

  .experience__list > li:last-child .experience__row {
    border-bottom: 0;
  }

  .experience__summary {
    align-items: center;
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-system);
  }

  .experience__summary::-webkit-details-marker {
    display: none;
  }

  .experience__summary:hover {
    background-color: var(--ink);
    color: var(--paper);
  }

  .experience__summary:hover :global(svg) {
    filter: invert(1);
  }

  .experience__summary:focus-visible {
    outline-offset: -4px;
  }

  .experience__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Disclosure triangle: points right when closed, down when open. */
  .experience__triangle {
    width: 0;
    height: 0;
    border-block: 0.4rem solid transparent;
    border-left: 0.55rem solid currentColor;
    transition: transform 120ms steps(2);
    flex-shrink: 0;
  }

  .experience__row[open] .experience__triangle {
    transform: rotate(90deg);
  }

  .experience__title {
    font-size: var(--text-lg);
  }

  /* On mobile, company and period stack under the title, indented. */
  .experience__company,
  .experience__period {
    padding-left: calc(0.55rem + 1.25rem + var(--space-4));
  }

  @media (min-width: 48rem) {
    .experience__company,
    .experience__period { padding-left: 0; }
  }

  /* Rows fold open/closed in a few chunky steps where the browser can
     animate <details> content; elsewhere they simply snap. */
  @media (prefers-reduced-motion: no-preference) {
    .experience__row {
      interpolate-size: allow-keywords;
    }

    .experience__row::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 130ms steps(4, end), content-visibility 130ms allow-discrete;
    }

    .experience__row[open]::details-content {
      block-size: auto;
    }
  }

  .experience__detail {
    padding: 0 var(--space-5) var(--space-5) calc(var(--space-5) + 0.55rem + 1.25rem + var(--space-4));
  }

  .experience__description {
    max-width: 65ch;
    margin-bottom: var(--space-3);
  }

  .experience__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
