---
/*
 * About — the story on the left, a Mac "Get Info" panel on the right.
 *
 * Get Info is how the Finder describes a file: icon + name on top, then
 * right-aligned labels ("Kind:", "Size:") with their values. Here it
 * describes Alejo, and ends with the XP bar drawn as a dithered progress
 * bar.
 */

import { aboutContent, siteMeta, heroContent } from '../data/portfolio';
import { getI18n } from '../i18n';
import Window from './Window.astro';
import PixelIcon from './PixelIcon.astro';

const { t, l } = getI18n(Astro);
---

<section id="about" class="section">
  <div class="container">
    <Window title={l(aboutContent.title)} info={[siteMeta.author, aboutContent.level]}>
      <div class="about__grid">

        <article class="about__story">
          <h3 class="about__story-title">{t.about.story}</h3>
          {l(aboutContent.paragraphs).map((paragraph) => (
            <p class="about__paragraph">{paragraph}</p>
          ))}
        </article>

        <aside class="about__info" aria-labelledby="about-info-title">
          <header class="about__info-head">
            <PixelIcon name="computer" scale={3} />
            <div>
              <h3 class="about__info-name" id="about-info-title">Alejo</h3>
              <p class="about__info-kind">{t.about.info}</p>
            </div>
          </header>

          <dl class="about__facts">
            {aboutContent.facts.map((fact) => (
              <div class="about__fact">
                <dt>{l(fact.label)}:</dt>
                <dd>{l(fact.value)}</dd>
              </div>
            ))}
            <div class="about__fact">
              <dt>{t.about.level}:</dt>
              <dd>
                {aboutContent.level}
                <div
                  class="about__meter"
                  role="meter"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow={aboutContent.levelProgress}
                  aria-label={t.about.meter(aboutContent.levelLabel)}
                >
                  <span class="about__meter-fill" style={`width: ${aboutContent.levelProgress}%;`}></span>
                </div>
                <span class="about__meter-label">{aboutContent.levelLabel}</span>
              </dd>
            </div>
          </dl>

          <p class="about__info-note">{l(heroContent.status)}</p>
        </aside>

      </div>
    </Window>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 56rem) {
    .about__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }

  /* ---------- Story ---------- */

  .about__story-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .about__paragraph {
    font-size: var(--text-lg);
    max-width: 62ch;
  }

  .about__paragraph + .about__paragraph {
    margin-top: var(--space-4);
  }

  /* ---------- Get Info panel ---------- */

  .about__info {
    align-self: start;
    border: var(--line);
    box-shadow: var(--shadow-window);
    padding: var(--space-5);
    font-family: var(--font-system);
  }

  .about__info-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: var(--px) dotted var(--ink);
  }

  .about__info-name {
    font-size: var(--text-xl);
  }

  .about__info-kind {
    font-size: var(--text-sm);
  }

  .about__facts {
    display: grid;
    gap: var(--space-2);
  }

  .about__fact {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-3);
  }

  .about__fact dt {
    text-align: right;
    font-weight: 700;
  }

  .about__meter {
    height: 1.25rem;
    margin-top: var(--space-2);
    border: var(--line);
    background-color: var(--paper);
  }

  .about__meter-fill {
    display: block;
    height: 100%;
    background-image: var(--checker-pattern);
    background-size: 4px 4px;
    border-right: var(--line);
    transition: width 1s steps(10, end) 250ms;
  }

  /* Empty until the window zooms open, then it fills in chunky steps. */
  :global(:root[data-motion]) :global(.window:not(.is-open)) .about__meter-fill {
    width: 0 !important;
  }

  .about__meter-label {
    font-size: var(--text-sm);
  }

  .about__info-note {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--px) dotted var(--ink);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
