---
/*
 * About — personal story on the left, "fact cards" + level meter on the right.
 *
 * The fact cards each show an icon and one line. Hovering slides them
 * slightly to the right (a nod to neobrutalism's playful motion).
 */

import { aboutContent } from '../data/portfolio';
import Icon from './Icon.astro';

const factsWithIcons = aboutContent.facts.map((fact) => ({
  ...fact,
  iconName: fact.icon as 'code' | 'coffee' | 'heart',
}));
---

<section id="about" class="section">
  <div class="container">

    <header class="section-header">
      <span class="section-header__icon">
        <Icon name="user" size={16} />
      </span>
      <h2 class="section-title">{aboutContent.title}</h2>
    </header>

    <div class="about__grid">

      {/* ---------- Story column ---------- */}
      <article class="card about__story">
        <h3 class="about__story-title">Mi Historia</h3>
        {aboutContent.paragraphs.map((paragraph) => (
          <p class="about__paragraph">{paragraph}</p>
        ))}
      </article>

      {/* ---------- Facts + level column ---------- */}
      <div class="about__facts">
        {factsWithIcons.map((fact) => (
          <div class="about__fact">
            <span class="about__fact-icon">
              <Icon name={fact.iconName} size={32} />
            </span>
            <span class="about__fact-text">{fact.text}</span>
          </div>
        ))}

        <div class="about__level bg-white border-4">
          <div class="about__level-row">
            <span class="about__level-label">LEVEL:</span>
            <span class="about__level-value">{aboutContent.level}</span>
          </div>
          <div class="about__level-bar">
            <div
              class="about__level-fill"
              style={`width: ${aboutContent.levelProgress}%;`}
            >
              <span class="about__level-fill-label">{aboutContent.levelLabel}</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .about__grid { grid-template-columns: 1fr 1fr; }
  }

  /* ---------- Story ---------- */

  .about__story {
    padding: var(--space-8);
    box-shadow: var(--shadow-medium);
  }

  .about__story-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-bottom-thick);
  }

  .about__paragraph {
    font-size: var(--text-lg);
  }

  .about__paragraph + .about__paragraph {
    margin-top: var(--space-4);
  }

  /* ---------- Facts ---------- */

  .about__facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about__fact {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    border: var(--border-medium);
    background-color: var(--color-green);
    padding: var(--space-6);
    transition: var(--transition-transform);
  }

  .about__fact:hover {
    transform: translateX(8px);
  }

  .about__fact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: var(--border-medium);
    background-color: var(--color-white);
    padding: var(--space-3);
  }

  .about__fact-text {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  /* ---------- Level meter ---------- */

  .about__level {
    padding: var(--space-6);
  }

  .about__level-row {
    margin-bottom: var(--space-4);
  }

  .about__level-label {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .about__level-value {
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .about__level-bar {
    height: 2rem;
    border: var(--border-medium);
    background-color: var(--color-white);
    position: relative;
    overflow: hidden;
  }

  .about__level-fill {
    background-color: var(--color-green);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about__level-fill-label {
    font-size: var(--text-sm);
    font-weight: 700;
  }
</style>
