---
/*
 * Base layout — every page on the site renders inside this shell.
 *
 * Responsibilities:
 *   • Provide the <head> with metadata.
 *   • Load the design tokens + base + components + utilities CSS, in that
 *     order so components can depend on tokens.
 *   • Apply saved preferences and the motion flag before first paint.
 *   • Load the small client-side scripts: duck menu, menu bar clock and
 *     the desktop animations (src/scripts/motion.ts).
 *   • Slot the page content.
 */

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/utilities.css';
import '../styles/desktops.css';

import { siteMeta } from '../data/portfolio';
import { STORAGE_KEYS, TERMINAL_FONT_OPTIONS, DEFAULT_TERMINAL_FONT } from '../scripts/preferences-options';
import { getI18n, LOCALES, localePath } from '../i18n';

const { locale, l } = getI18n(Astro);
const languagePaths = Object.fromEntries(LOCALES.map((option) => [option, localePath(option)]));
/* hreflang wants absolute URLs; they become absolute once `site` is set in
   astro.config.mjs. */
const alternateUrl = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

const altTerminalFonts = TERMINAL_FONT_OPTIONS
  .map((option) => option.value)
  .filter((value) => value !== DEFAULT_TERMINAL_FONT);

interface Props {
  title?: string;
  description?: string;
}

const { title = l(siteMeta.title), description = l(siteMeta.description) } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content="website" />
    <meta property="og:locale"      content={locale === 'es' ? 'es_ES' : 'en_GB'} />

    {LOCALES.map((option) => (
      <link rel="alternate" hreflang={option} href={alternateUrl(localePath(option))} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrl(localePath('es'))} />

    {/* Apply saved preferences before first paint so the page never flashes
        the wrong theme. The controls live in src/scripts/preferences.ts. */}
    <script is:inline define:vars={{ keys: STORAGE_KEYS, altTerminalFonts, languagePaths }}>
      try {
        // A saved language other than this page's: go to that version now.
        const language = localStorage.getItem(keys.language);
        if (language in languagePaths && language !== document.documentElement.lang) {
          location.replace(languagePaths[language] + location.hash);
        }

        const theme = localStorage.getItem(keys.theme);
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        const font = localStorage.getItem(keys.terminalFont);
        if (altTerminalFonts.includes(font)) document.documentElement.dataset.termFont = font;
        if (localStorage.getItem(keys.trash) === '1') document.documentElement.dataset.trash = 'empty';
      } catch {}

      // Virtual desktops are on unless the visitor turned them off.
      try {
        if (localStorage.getItem(keys.scrollMode) !== 'continuous') document.documentElement.dataset.desktops = '';
      } catch {
        document.documentElement.dataset.desktops = '';
      }

      // Animations (src/scripts/motion.ts) hide windows until they zoom open.
      // If that module hasn't booted within 3s, show everything as-is.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const root = document.documentElement;
        root.dataset.motion = '';
        setTimeout(() => { if (!('motionReady' in root.dataset)) delete root.dataset.motion; }, 3000);
      }
    </script>
  </head>

  <body>
    <slot />

    {/* Duck menu + menu bar clock — tiny inline script, no framework needed. */}
    <script>
      import { clientStrings } from '../i18n/client';

      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');

      if (menuButton && menu) {
        const setOpen = (open: boolean) => {
          menu.hidden = !open;
          menuButton.setAttribute('aria-expanded', String(open));
        };

        menuButton.addEventListener('click', () => setOpen(menu.hidden));

        // Close on picking an entry, clicking elsewhere, or pressing Escape.
        // Picking an entry blinks it before the menu closes, like the
        // original Finder. In-page links wait for the blink to finish.
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        menu.querySelectorAll<HTMLElement>('a, button').forEach((entry) => {
          entry.addEventListener('click', (event) => {
            if (reduceMotion) return setOpen(false);
            const href = entry.getAttribute('href');
            const inPage = href?.startsWith('#');
            if (inPage) event.preventDefault();
            entry.classList.add('is-blinking');
            setTimeout(() => {
              entry.classList.remove('is-blinking');
              setOpen(false);
              if (inPage && href) {
                document.querySelector(href)?.scrollIntoView();
                history.pushState(null, '', href);
              }
            }, 180);
          });
        });
        document.addEventListener('click', (event) => {
          if (!menu.hidden && !menu.parentElement?.contains(event.target as Node)) setOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            menuButton.focus();
          }
        });
      }

      const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
      if (clock) {
        const format = new Intl.DateTimeFormat(clientStrings().dateLocale, { weekday: 'short', hour: '2-digit', minute: '2-digit' });
        const tick = () => {
          const now = new Date();
          clock.textContent = format.format(now);
          clock.dateTime = now.toISOString();
        };
        tick();
        setInterval(tick, 15_000);
      }
    </script>

    <script>
      import '../scripts/motion';
      import '../scripts/desktops';
    </script>
  </body>
</html>
